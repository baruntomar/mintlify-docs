{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Mintlify Starter Kit",
  "colors": {
    "primary": "#16A34A",
    "light": "#07C983",
    "dark": "#15803D"
  },
  "favicon": {
    "light": "/images/bollywar-crown-64.png",
    "dark": "/images/bollywar-crown-64.png"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Individual",
            "pages": [
              {
                "group": "About",
                "pages": [
                  "about-us"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Legal",
        "groups": [
          {
            "group": "Legal",
            "pages": [
              "legal/terms-and-conditions",
              "legal/privacy-policy",
              "legal/content-policies",
              "legal/code-of-conduct"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/images/bollywar-wordmark-on-light-64h.png",
    "dark": "/images/bollywar-wordmark-on-dark-64h.png"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@mintlify.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/bolly_war"
    }
  },
  "fonts": {
    "family": "Inter"
  }
}
